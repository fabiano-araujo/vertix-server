# Authentication used by the existing Vertix login/JWT flow.
TOKEN_KEY=replace-with-a-long-random-secret

# Story/ficha text uses DeepSeek via OpenRouter. Codex is only for reference images.
OPENROUTER_STORY_MODEL=deepseek/deepseek-v4-flash-0731

# Optional leftover from the old Codex text worker. Images use the local Codex task.
CODEX_MODEL=

# Optional isolated directory used by the Codex SDK. It must not contain secrets.
CODEX_WORKING_DIRECTORY=
